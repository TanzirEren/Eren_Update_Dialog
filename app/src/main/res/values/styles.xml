<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Eren" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/eren_accent</item>
        <item name="colorAccent">@color/eren_accent</item>
        <item name="android:windowBackground">@color/eren_bg</item>
    </style>

    <!-- Window theme used by the Eren.show() dialog -->
    <style name="ErenDialogTheme" parent="android:Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/ErenDialogAnimation</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <style name="ErenDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/eren_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/eren_dialog_out</item>
    </style>

</resources>
